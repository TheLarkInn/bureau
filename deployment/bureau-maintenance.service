[Unit]
Description=Bureau single-owner maintenance reconciliation
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=exec
User=bureau
Group=bureau
WorkingDirectory=/opt/bureau/source
Environment=HOME=/var/lib/bureau-maintenance-runtime
Environment=COPILOT_HOME=/var/lib/bureau-maintenance-runtime/copilot
Environment=BUREAU_HOME=/var/lib/bureau-maintenance
Environment=PATH=/opt/bureau/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/bureau/maintenance.env
StateDirectory=bureau-maintenance
StateDirectoryMode=0700
ReadWritePaths=/var/lib/bureau-maintenance-runtime/copilot
ReadWritePaths=/var/lib/bureau-maintenance-runtime/logs
ReadWritePaths=/var/lib/bureau-maintenance-runtime/tmp
CacheDirectory=bureau-maintenance
CacheDirectoryMode=0700
RuntimeDirectory=bureau-maintenance
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock --nonblock --no-fork /var/lib/bureau-maintenance/owner.lock /bin/bash /opt/bureau/source/deployment/run-owner.sh
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=0
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096
OOMPolicy=stop
KillSignal=SIGTERM
KillMode=mixed
FinalKillSignal=SIGKILL
TimeoutStopSec=70min
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
